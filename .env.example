# ==============================================================================
# VARAH SYSTEMS — ENTERPRISE ADMIN PLATFORM CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://varah.ai
NEXT_PUBLIC_SITE_NAME="VARAH SYSTEMS"

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Connection-pooled database URL (e.g., Supabase Transaction Pooler, port 6543)
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct database connection URL (Used for Prisma migrations, port 5432)
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (NextAuth / JWT / Session)
# ------------------------------------------------------------------------------
# Generate via: openssl rand -base64 32
AUTH_SECRET="your-32-byte-ultra-secure-random-secret-key-here"
NEXTAUTH_URL="https://varah.ai/admin"
AUTH_SESSION_COOKIE_NAME="__Host-varah-admin-session"
AUTH_SESSION_MAX_AGE=604800 # 7 days in seconds

# Initial Seed Admin Account (Used by seed script)
INITIAL_ADMIN_EMAIL="admin@varah.ai"
INITIAL_ADMIN_PASSWORD="ReplaceWithUltraSecurePassword2026!"
INITIAL_ADMIN_NAME="Dhruv & Bhavya (Founders)"

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE & MEDIA UPLOADS (Cloudflare R2 / AWS S3 / Supabase Storage)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="s3" # "s3" | "supabase" | "r2"
STORAGE_ENDPOINT="https://[ACCOUNT_ID].r2.cloudflarestorage.com"
STORAGE_BUCKET="varah-media-production"
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID="your-r2-or-s3-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-r2-or-s3-secret-access-key"
NEXT_PUBLIC_STORAGE_PUBLIC_URL="https://assets.varah.ai"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL & LEAD NOTIFICATIONS (SMTP / Resend)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="resend"
SMTP_PASS="re_your_api_key_here"
SMTP_FROM_EMAIL="alerts@varah.ai"
SMTP_FROM_NAME="VARAH Operations Alerts"
LEAD_NOTIFICATION_RECIPIENTS="founders@varah.ai,dhruv@varah.ai"

# ------------------------------------------------------------------------------
# 6. EXTERNAL WEBHOOKS & TELEMETRY ALERTS
# ------------------------------------------------------------------------------
# Slack Incoming Webhook for instant #leads-feed notifications
SLACK_LEAD_WEBHOOK_URL="https://hooks.slack.com/your-slack-webhook-url-here"

# Discord Webhook fallback
DISCORD_LEAD_WEBHOOK_URL="https://discord.com/api/webhooks/your-discord-webhook-url-here"

# ------------------------------------------------------------------------------
# 7. THIRD-PARTY INTEGRATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
# Calendly Personal Access Token (for syncing Discovery bookings)
CALENDLY_API_KEY="your-calendly-token-here"

# HubSpot Private App Token (for syncing qualified enterprise leads)
HUBSPOT_ACCESS_TOKEN="your-hubspot-token-here"

# ------------------------------------------------------------------------------
# 8. ANALYTICS & PRIVACY-COMPLIANT EVENT LOGGING
# ------------------------------------------------------------------------------
# Google Analytics 4 (Optional Client-Side Measurement ID)
NEXT_PUBLIC_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"

# Self-Hosted / Privacy Telemetry Domain (e.g. Plausible / PostHog)
NEXT_PUBLIC_ANALYTICS_DOMAIN="varah.ai"

# Salt used for one-way SHA-256 IP hashing (GDPR compliant telemetry)
ANALYTICS_IP_SALT="unique-telemetry-hashing-salt-string"
