{
  "name": "varah-systems-platform",
  "version": "2.0.0",
  "private": true,
  "description": "VARAH SYSTEMS — Enterprise AI Automation Agency Platform & SaaS Admin Console",
  "scripts": {
    "build:css": "tailwindcss -i app/globals.css -o public/admin.css",
    "build:nav": "node scripts/sync-nav.js",
    "check:nav": "node scripts/sync-nav.js --check",
    "build:assets": "node scripts/generate-assets.js",
    "build:meta": "node scripts/sync-meta.js",
    "check:meta": "node scripts/sync-meta.js --check",
    "build:sitemap": "node scripts/build-sitemap.js",
    "check:seo": "node scripts/check-seo.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:form-rules": "tsx scripts/check-form-rules.ts",
    "check:env": "node scripts/check-env.mjs",
    "check:legal": "node scripts/check-legal.mjs",
    "check:consent": "tsx scripts/check-consent.ts",
    "check:analytics": "tsx scripts/check-analytics.ts",
    "check:headers": "tsx scripts/check-headers.ts",
    "check:perf": "tsx scripts/check-perf.ts",
    "check:ai-tells": "node scripts/check-ai-tells.mjs",
    "check:plain-language": "node scripts/check-plain-language.mjs",
    "test:nav": "node scripts/test-nav-drawer.js",
    "test:contact": "tsx scripts/test-contact-api.ts",
    "dev": "npm run build:css && next dev",
    "build": "npm run build:nav && npm run build:meta && npm run build:sitemap && npm run build:css && next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "check:overflow": "node scripts/check-overflow.js",
    "db:migrate": "prisma migrate dev"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "clsx": "^2.1.1",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.35",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "lighthouse": "^13.5.0",
    "opentype.js": "^2.0.0",
    "playwright": "^1.64.1",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
