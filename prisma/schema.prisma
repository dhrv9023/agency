// ==============================================================================
// VARAH SYSTEMS — ENTERPRISE ADMIN PLATFORM DATABASE SCHEMA (PRISMA ORM)
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

// ------------------------------------------------------------------------------
// ENUMS & TYPES
// ------------------------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  PROPOSED
  DISCOVERY
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SCHEDULED
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

enum IntegrationType {
  SMTP
  CALENDLY
  SLACK_WEBHOOK
  DISCORD_WEBHOOK
  HUBSPOT
  STRIPE
  CUSTOM_API_KEY
}

// ------------------------------------------------------------------------------
// MODULE 8: USERS, AUTH, ROLES & AUDIT LOGS
// ------------------------------------------------------------------------------

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  name             String
  passwordHash     String?
  avatarUrl        String?
  role             UserRole     @default(VIEWER)
  isActive         Boolean      @default(true)
  twoFactorEnabled Boolean      @default(false)
  twoFactorSecret  String?
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  sessions         Session[]
  assignedLeads    Lead[]       @relation("AssignedLeads")
  leadNotes        LeadNote[]
  assignedProjects ProjectTeamMember[]
  authoredPosts    Post[]
  auditLogs        AuditLog[]

  @@index([email])
  @@index([role])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String   // e.g. "LEAD.UPDATE_STAGE", "POST.PUBLISH", "USER.INVITE"
  entityType   String   // e.g. "Lead", "Post", "Project", "Integration"
  entityId     String?
  metadata     Json?    // Contextual information
  diffBefore   Json?    // Snapshot before mutation
  diffAfter    Json?    // Snapshot after mutation
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SiteSetting {
  id             String   @id @default("global_config")
  siteName       String   @default("VARAH SYSTEMS")
  siteUrl        String   @default("https://varah.ai")
  logoUrl        String   @default("/assets/logo.svg")
  contactEmail   String   @default("contact@varah.ai")
  supportEmail   String?
  phone          String?
  socialLinks    Json?    // { twitter: "", linkedin: "", github: "" }
  defaultMetaTitle String?
  defaultMetaDesc  String?
  defaultOgImage   String?
  robotsTxt        String?
  sitemapEnabled   Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model Integration {
  id          String          @id @default(uuid())
  type        IntegrationType
  name        String
  description String?
  isEnabled   Boolean         @default(true)
  config      Json            // Masked/encrypted credentials & options
  apiKey      String?         // Rotatable API key token
  lastSyncedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([type, name])
  @@index([type])
}

// ------------------------------------------------------------------------------
// MODULE 2: LEADS & CRM PIPELINE (MOST CRITICAL ENGINE)
// ------------------------------------------------------------------------------

model Lead {
  id             String              @id @default(uuid())
  name           String
  email          String
  phone          String?
  company        String?
  website        String?
  budgetRange    String?             // e.g. "$10,000 - $25,000"
  serviceInterest String?            // e.g. "REVENUE_ENGINE", "TELEPHONY"
  message        String              @db.Text
  stage          LeadStage           @default(NEW)
  priority       LeadPriority        @default(MEDIUM)
  isSpam         Boolean             @default(false)
  
  // Tracking Attribution
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  convertedOnPage String?            // e.g. "/solutions/ai-voice" or "/book"
  referrerUrl    String?

  // Management & Ownership
  assignedToId   String?
  assignedTo     User?               @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastContactedAt DateTime?
  
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Relations
  notes          LeadNote[]
  statusHistory  LeadStatusHistory[]
  attachments    LeadAttachment[]
  tags           LeadTagAssignment[]
  linkedClient   Client?

  @@index([stage])
  @@index([email])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([isSpam])
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([authorId])
}

model LeadStatusHistory {
  id         String    @id @default(uuid())
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage  LeadStage
  toStage    LeadStage
  changedById String?
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([leadId])
  @@index([createdAt])
}

model LeadAttachment {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  filename  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  @@index([leadId])
}

model LeadTag {
  id        String               @id @default(uuid())
  name      String               @unique
  colorHex  String               @default("#00f0ff")
  leads     LeadTagAssignment[]
}

model LeadTagAssignment {
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tagId     String
  tag       LeadTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

// ------------------------------------------------------------------------------
// MODULE 3: CLIENTS & PROJECTS
// ------------------------------------------------------------------------------

model Client {
  id             String    @id @default(uuid())
  name           String
  company        String
  email          String    @unique
  phone          String?
  billingAddress String?   @db.Text
  notes          String?   @db.Text
  convertedFromLeadId String? @unique
  convertedFromLead   Lead?   @relation(fields: [convertedFromLeadId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  projects       Project[]

  @@index([email])
  @@index([company])
}

model Project {
  id            String              @id @default(uuid())
  clientId      String
  client        Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title         String
  code          String              @unique // e.g. "PRJ-VARAH-04"
  description   String?             @db.Text
  status        ProjectStatus       @default(DISCOVERY)
  contractValue Decimal?            @db.Decimal(12, 2)
  startDate     DateTime?
  targetEndDate DateTime?
  actualEndDate DateTime?
  repositoryUrl String?
  documentationUrl String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  teamMembers   ProjectTeamMember[]
  milestones    ProjectMilestone[]
  files         ProjectFile[]

  @@index([clientId])
  @@index([status])
}

model ProjectTeamMember {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleInProject String @default("Lead Engineer") // e.g. "Lead Engineer", "Solution Architect"

  @@id([projectId, userId])
}

model ProjectMilestone {
  id          String          @id @default(uuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int             @default(0)
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId, order])
}

model ProjectFile {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  category    String?  // e.g. "SOW", "Architecture Spec", "Invoice"
  createdAt   DateTime @default(now())

  @@index([projectId])
}

// ------------------------------------------------------------------------------
// MODULE 4: CONTENT MANAGEMENT SYSTEM (CMS)
// ------------------------------------------------------------------------------

model Service {
  id          String        @id @default(uuid())
  slug        String        @unique
  title       String
  shortDesc   String
  longDesc    String        @db.Text
  icon        String        // FontAwesome icon class or SVG identifier
  features    Json          // string[] of bullet features
  connectedStack Json?      // string[] of software tools
  pricingTier String?       // e.g. "From $4,500"
  order       Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  metaTitle   String?
  metaDesc    String?
  ogImage     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([slug])
  @@index([status])
}

model CaseStudy {
  id           String        @id @default(uuid())
  slug         String        @unique
  title        String
  clientName   String
  industry     String
  challenge    String        @db.Text
  solution     String        @db.Text
  results      Json          // [{ metric: "Speed to Lead", value: "< 45s", change: "+420%" }]
  techStack    Json          // string[] of tools
  heroImageUrl String
  galleryUrls  Json?         // string[] of image URLs
  featured     Boolean       @default(false)
  order        Int           @default(0)
  status       ContentStatus @default(PUBLISHED)
  metaTitle    String?
  metaDesc     String?
  ogImage      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([slug])
  @@index([industry])
  @@index([featured])
}

model Post {
  id           String        @id @default(uuid())
  slug         String        @unique
  title        String
  excerpt      String?       @db.Text
  content      String        @db.Text // Markdown or Tiptap JSON string
  coverImage   String?
  authorId     String
  author       User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  tags         Json          // string[]
  readingTimeMin Int         @default(3)
  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  metaTitle    String?
  metaDesc     String?
  ogImage      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([slug])
  @@index([status, publishedAt])
  @@index([authorId])
}

model Testimonial {
  id          String   @id @default(uuid())
  quote       String   @db.Text
  authorName  String
  authorRole  String
  companyName String
  companyLogo String?
  avatarUrl   String?
  rating      Int      @default(5)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([featured, order])
}

model TeamMember {
  id          String   @id @default(uuid())
  name        String
  role        String
  bio         String?  @db.Text
  photoUrl    String
  socials     Json?    // { linkedin: "", twitter: "", github: "" }
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String   @db.Text
  category  String   @default("General") // e.g. "Pricing", "Architecture", "Timeline"
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
}

model HomepageSection {
  id           String   @id // e.g. "hero", "stats_strip", "logos_strip", "what_we_build"
  name         String
  contentData  Json     // Strongly typed content per section
  updatedAt    DateTime @updatedAt
}

// ------------------------------------------------------------------------------
// MODULE 5: MEDIA LIBRARY & ASSET ASOCIATION
// ------------------------------------------------------------------------------

model MediaFolder {
  id        String      @id @default(uuid())
  name      String
  slug      String      @unique
  createdAt DateTime    @default(now())
  files     MediaItem[]
}

model MediaItem {
  id           String       @id @default(uuid())
  filename     String
  originalName String
  url          String
  fileSize     Int          // bytes
  mimeType     String
  width        Int?
  height       Int?
  altText      String?
  folderId     String?
  folder       MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  usageCount   Int          @default(0) // Protects from deletion when referenced
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([mimeType])
  @@index([folderId])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// MODULE 6: ANALYTICS & TELEMETRY
// ------------------------------------------------------------------------------

model AnalyticsEvent {
  id         String   @id @default(uuid())
  eventType  String   // "pageview", "cta_click", "lead_submission", "calculator_calc"
  pathname   String   // "/solutions/ai-voice"
  ctaTarget  String?  // "start-project-btn", "book-discovery"
  referrer   String?
  deviceType String?  // "desktop", "mobile", "tablet"
  browser    String?
  os         String?
  country    String?
  ipHash     String?  // Anonymized SHA-256 for GDPR compliance
  metadata   Json?    // Context payload
  createdAt  DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([pathname])
  @@index([createdAt])
}

model DailyTrafficMetric {
  id              String   @id @default(uuid())
  date            DateTime @unique @db.Date
  totalPageviews  Int      @default(0)
  uniqueVisitors  Int      @default(0)
  leadSubmissions Int      @default(0)
  topSources      Json?    // [{ source: "google", count: 120 }, { source: "linkedin", count: 85 }]
  deviceBreakdown Json?    // { desktop: 70, mobile: 28, tablet: 2 }
  updatedAt       DateTime @updatedAt

  @@index([date])
}

// ------------------------------------------------------------------------------
// MODULE 7: NEWSLETTER & SUBSCRIBERS
// ------------------------------------------------------------------------------

model NewsletterSubscriber {
  id           String           @id @default(uuid())
  email        String           @unique
  source       String           @default("footer") // e.g. "footer", "blog_inline", "calculator"
  status       SubscriberStatus @default(SUBSCRIBED)
  segmentTags  Json?            // string[] e.g. ["enterprise", "voice-ai"]
  subscribedAt DateTime         @default(now())
  unsubscribedAt DateTime?

  @@index([email])
  @@index([status])
}
